<?xml version="1.0" encoding="utf-8"?>
<!-- .cc-btn.primary: a solid coral pill. Focus draws a 3dp ink ring, visible from across the
     room on a TV driven by a remote; pressed deepens the coral. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="@color/ui_accent" /><corners android:radius="40dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_accent_press" /><corners android:radius="40dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_accent" /><stroke android:width="3dp" android:color="@color/ui_ring" /><corners android:radius="40dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/ui_accent" /><corners android:radius="40dp" /></shape>
    </item>
</selector>
