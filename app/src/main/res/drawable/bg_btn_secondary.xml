<?xml version="1.0" encoding="utf-8"?>
<!-- .cc-btn: surface pill with a hairline border; same focus ring as the primary. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_surface2" /><stroke android:width="1dp" android:color="@color/ui_border" /><corners android:radius="40dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_surface2" /><stroke android:width="3dp" android:color="@color/ui_ring" /><corners android:radius="40dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/ui_surface" /><stroke android:width="1dp" android:color="@color/ui_border" /><corners android:radius="40dp" /></shape>
    </item>
</selector>
